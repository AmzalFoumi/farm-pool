# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug and logs
npm-debug.*
yarn-debug.*
yarn-error.*
logs/
*.log

# macOS
.DS_Store
*.pem

# editors — the team is split across VS Code and JetBrains.
# The `**/` prefix matters: a pattern containing a slash is anchored to this file's directory, so a
# bare `.vscode/*` would miss mobile/.vscode/ entirely. Shared editor config is re-admitted;
# personal state (workspace layout, local launch tweaks) is not.
.idea/
*.iml
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/extensions.json
!**/.vscode/launch.json

# local env files
# Expo's template ships only `.env*.local`, which does NOT match a plain `.env` — the single most
# likely file to leak a database URL or API key. Ignore every .env, then re-admit the example.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
# Re-anchored from Expo's /ios and /android: the app lives in mobile/, not at the repo root.
mobile/ios/
mobile/android/

# build output (dist/ already covered under Expo above)
build/

# local working record — see .plans/STRUCTURE.md
CLAUDE.local.md
.plans.local/

# NestJS (api/) — the entries deferred at SETUP-1 until the framework was chosen.
# dist/ and node_modules/ are already covered above; these are what Nest adds on top.
coverage/
.nest/
