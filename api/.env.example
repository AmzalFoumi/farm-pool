# Copy to `.env` and fill in. `.env` is gitignored; this file is the documented shape.
#
# The api refuses to start if a required key is missing or malformed, and prints which one —
# see src/config/env.ts for the exact rules.

# MongoDB connection string. Atlas gives you this under "Connect → Drivers"; a local server is
# mongodb://127.0.0.1:27017/farm-pool. The database name goes at the end of the path.
DATABASE_URI=

# Secret that signs access tokens (HS256). At least 32 characters; generate one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every user out.
JWT_SECRET=

# How long an access token stays valid. Default 30d.
JWT_EXPIRES_IN=30d

# Where the server listens. HOST=0.0.0.0 so a phone on the same Wi-Fi can reach it; 127.0.0.1
# would only answer this machine.
PORT=3000
HOST=0.0.0.0

# Optional. `development` (default), `test` or `production`. The dev seed refuses to run in
# production.
# NODE_ENV=development

# Optional, dev seed only: the password of the seed farmer (+94771000001). Default `longenough`.
# SEED_PASSWORD=

# Optional, e2e tests only: point the tests at an existing database instead of downloading
# mongodb-memory-server (~100 MB on first run). The tests write to it, so never use production.
# E2E_DATABASE_URI=
