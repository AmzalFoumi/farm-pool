# NestJS — api/
#
# Scoped deliberately. The root .gitignore already covers node_modules/, dist/, .env* and editor
# directories for the whole repo; this file exists so `api/` stays correct if it is ever moved,
# cloned or opened on its own. Duplication with the root is intentional and harmless.
#
# This is NOT a copy of nestjs/typescript-starter's .gitignore. That file is generated by a
# JetBrains plugin and is ~300 lines of Visual Studio, ReSharper and BizTalk rules for a Node
# project. These are the entries out of it that describe something api/ actually produces.

# compiled output
/dist
/build
*.tsbuildinfo

# dependencies
/node_modules

# tests
/coverage
/.nyc_output

# nest build cache
.nest/

# logs
logs/
*.log
npm-debug.log*

# env — .env.example is committed on purpose, everything else is not
.env
.env.*
!.env.example
