# Copy to `.env` (gitignored). Expo inlines `EXPO_PUBLIC_*` variables into the app bundle at
# build time, so restart `expo start` after changing one. Never put a secret here — everything
# with this prefix ships inside the app.

# Where the api is. On a physical phone this must be the development machine's LAN address,
# not localhost — localhost on the phone is the phone. Find it with `ipconfig` (Windows) or
# `ifconfig` (macOS). The api listens on 0.0.0.0:3000 by default (api/.env.example).
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
