{
  "name": "farm-pool",
  "version": "0.1.0",
  "private": true,
  "description": "Rural Farmer-to-Market Direct Connect \u2014 Group SE-38",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "mobile",
    "api",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace mobile",
    "api": "npm run start:dev --workspace api",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml,css}\" --cache",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "test:e2e": "node --test \"tests/e2e/*.test.mjs\"",
    "test:e2e:ui": "maestro test tests/e2e/maestro"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
